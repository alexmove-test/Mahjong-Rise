rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name',
          'rating',
          'totalStars',
          'levelsUnlocked',
          'sumBestScores',
          'updatedAt',
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 100000000
        && request.resource.data.totalStars is int
        && request.resource.data.totalStars >= 0
        && request.resource.data.totalStars <= 720
        && request.resource.data.levelsUnlocked is int
        && request.resource.data.levelsUnlocked >= 1
        && request.resource.data.levelsUnlocked <= 240
        && request.resource.data.sumBestScores is int
        && request.resource.data.sumBestScores >= 0
        && request.resource.data.sumBestScores <= 20000000
        && request.resource.data.rating ==
             request.resource.data.totalStars * 100000 +
             request.resource.data.sumBestScores +
             request.resource.data.levelsUnlocked * 500;

      allow delete: if false;
    }

    match /weekly/{weekId}/players/{userId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'name',
          'rating',
          'weeklyStars',
          'weeklyClears',
          'weeklyDailies',
          'updatedAt',
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 2207000
        && request.resource.data.weeklyStars is int
        && request.resource.data.weeklyStars >= 0
        && request.resource.data.weeklyStars <= 200
        && request.resource.data.weeklyClears is int
        && request.resource.data.weeklyClears >= 0
        && request.resource.data.weeklyClears <= 80
        && request.resource.data.weeklyDailies is int
        && request.resource.data.weeklyDailies >= 0
        && request.resource.data.weeklyDailies <= 7
        && request.resource.data.rating ==
             request.resource.data.weeklyStars * 10000 +
             request.resource.data.weeklyClears * 2500 +
             request.resource.data.weeklyDailies * 1000;

      allow delete: if false;
    }
  }
}
