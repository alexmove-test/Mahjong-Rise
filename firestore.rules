rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name',
          'rating',
          'totalStars',
          'levelsUnlocked',
          'sumBestScores',
          'updatedAt',
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 10000000
        && request.resource.data.totalStars is int
        && request.resource.data.totalStars >= 0
        && request.resource.data.totalStars <= 72
        && request.resource.data.levelsUnlocked is int
        && request.resource.data.levelsUnlocked >= 1
        && request.resource.data.levelsUnlocked <= 24
        && request.resource.data.sumBestScores is int
        && request.resource.data.sumBestScores >= 0;

      allow delete: if false;
    }
  }
}
